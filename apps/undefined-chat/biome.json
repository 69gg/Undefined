{
    "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
    "extends": [],
    "formatter": {
        "indentStyle": "tab"
    },
    "files": {
        "includes": [
            "**/src/**/*.ts",
            "**/src/**/*.tsx",
            "**/package.json",
            "**/tsconfig.json",
            "**/vite.config.ts",
            "**/src-tauri/tauri.conf.json",
            "**/src-tauri/capabilities/**/*.json"
        ]
    },
    "linter": {
        "rules": {
            "a11y": {
                "useSemanticElements": "off"
            },
            "correctness": {
                "noUnusedVariables": "warn"
            },
            "suspicious": {
                "noArrayIndexKey": "error"
            }
        }
    }
}
