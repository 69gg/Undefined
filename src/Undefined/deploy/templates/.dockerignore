# 构建上下文瘦身：本体镜像只需要 pyproject/uv.lock/src/res/img/config/README。
# CI 用 --file 指定模板 Dockerfile 时，本文件即仓库根的 .dockerignore。

.git
.gitmodules
.github

# 运行态与产物
data
logs
dist
deploy
.cache
.coverage
.pytest_cache
.mypy_cache
.ruff_cache

# Python 环境
.venv
venv
__pycache__
*.pyc

# 前端与原生 App 构建产物
node_modules
apps/**/node_modules
apps/**/dist
apps/**/src-tauri/target
apps/**/src-tauri/gen

# 文档与编辑器
docs
.vscode
.idea
.claude
.codex
*.md
